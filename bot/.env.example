# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Кто может ставить задачи (через запятую). Узнать свой id: написать боту /id
BOT_ALLOWED_USER_IDS=
# В каких группах бот работает (через запятую, пусто — в любых, где есть владелец)
BOT_ALLOWED_CHAT_IDS=
# Доступ к Claude: одно из двух
# CLAUDE_CODE_OAUTH_TOKEN — из `claude setup-token` (подписка Claude Pro/Max)
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY — ключ API (оплата по токенам)
ANTHROPIC_API_KEY=
# Fine-grained GitHub token на репозиторий: Contents RW, Actions R
BOT_GITHUB_TOKEN=
GITHUB_REPO=aStormspirit/chebutap
# Адрес игры для smoke-проверки после деплоя (необязательно)
APP_URL=
CLAUDE_MODEL=claude-opus-5-5
